NODE_ENV=development
WEB_PORT=5174
API_PORT=3001
RAG_PORT=8001

# 生产环境必填；缺失时 API 拒绝启动（禁止使用默认密钥）
JWT_SECRET=
# 允许的 CORS 来源，逗号分隔
CORS_ORIGINS=http://localhost:5174,http://localhost:3002

DATABASE_URL=file:./data/app.db
UPLOAD_DIR=./data/uploads

# API 网关 → RAG 服务的内部共享密钥；配置后 RAG 所有端点要求 X-API-Key
RAG_API_KEY=
RAG_SERVICE_URL=http://localhost:8001
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=battery_line_knowledge_v1

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BATCH_SIZE=32

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

RAG_TOP_K=5
RAG_TEMPERATURE=0.2
RAG_MAX_CONTEXT_CHARS=12000

# LLM 本地用量保护（0 表示关闭对应限制）
LLM_USAGE_LOG_PATH=./data/llm_usage.jsonl
LLM_MAX_INPUT_CHARS_PER_REQUEST=25000
LLM_DAILY_REQUEST_LIMIT=50
LLM_DAILY_INPUT_CHAR_LIMIT=300000
