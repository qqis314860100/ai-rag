NODE_ENV=development
WEB_PORT=5174
API_PORT=3001
RAG_PORT=8000

# 生产环境必填；缺失时 API 拒绝启动（禁止使用默认密钥）
JWT_SECRET=
# 允许的 CORS 来源，逗号分隔
CORS_ORIGINS=http://localhost:5174,http://localhost:3002

DATABASE_URL=file:./data/app.db
UPLOAD_DIR=./data/uploads

# API 网关 → RAG 服务的内部共享密钥；配置后 RAG 所有端点要求 X-API-Key
RAG_API_KEY=
RAG_SERVICE_URL=http://localhost:8000
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=battery_line_knowledge_v1

# 语料命名空间默认标签："" 或 battery 都回退到电池语料默认 collection，存量行为不变。
# 外部 AI 能力服务调用方可随请求带 namespace（如 ep-docs）选择独立语料集合。
RAG_NAMESPACE_DEFAULT=battery
# 可选：为某个 namespace 显式指定 Chroma collection 名（键名 = RAG_NAMESPACE_COLLECTION_ + 大写 namespace，
# 非字母数字字符转下划线；不配置时按 "ns_<namespace>" 规则自动生成）。
# RAG_NAMESPACE_COLLECTION_EP_DOCS=ep_docs_knowledge_v1

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BATCH_SIZE=32

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 外发开关：离线部署建议保持关闭，需要外部模型时改为 deepseek 并配置 API Key。
LLM_PROVIDER=mock
IMAGE_GEN_ENABLED=false
TELEMETRY_ENABLED=false
VITE_TELEMETRY_ENABLED=false

# 企业集成 API Token，格式：client_id:plain_token 或 client_id:sha256:<hash>，多个用逗号分隔。
INTEGRATION_API_TOKENS=
INTEGRATION_ALLOWED_SECURITY_LEVELS=public,internal
INTEGRATION_RATE_LIMIT_PER_MINUTE=60

# 企业内 IM / 工单系统 webhook，可被 settings 表同名配置覆盖。
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_EVENTS=knowledge_card.published,document.conflict,chat.refusal.high_frequency
WEBHOOK_REFUSAL_THRESHOLD=5
WEBHOOK_REFUSAL_COOLDOWN_MS=300000

# MES/PLM/ERP 离线导出包只允许从该目录导入，支持 csv/json/pdf。
OFFLINE_IMPORT_ROOT=./data/offline-import

RAG_TOP_K=5
RAG_TEMPERATURE=0.2
RAG_MAX_CONTEXT_CHARS=12000

# LLM 本地用量保护（0 表示关闭对应限制）
LLM_USAGE_LOG_PATH=./data/llm_usage.jsonl
LLM_MAX_INPUT_CHARS_PER_REQUEST=25000
LLM_DAILY_REQUEST_LIMIT=50
LLM_DAILY_INPUT_CHAR_LIMIT=300000
LLM_DAILY_REQUEST_LIMIT_PER_USER=50
LLM_HOURLY_REQUEST_LIMIT_PER_USER=20
